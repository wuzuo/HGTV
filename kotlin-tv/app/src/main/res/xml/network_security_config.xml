<network-security-config>
    <!-- 局域网内的可选 HTTP 服务（构建期注入的地址或模拟器上的 10.0.2.2）需要明文流量。
         network-security-config 的 base-config 会覆盖 manifest 的 usesCleartextTraffic，
         必须在这里一并放开，否则 OkHttp 会抛 CLEARTEXT communication ... not permitted。 -->
    <base-config cleartextTrafficPermitted="true"/>
    <domain-config cleartextTrafficPermitted="true"><domain includeSubdomains="true">douyinvod.com</domain><domain includeSubdomains="true">byteicdn.com</domain><domain includeSubdomains="true">byteimg.com</domain></domain-config>
</network-security-config>
